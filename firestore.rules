rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          'email' in request.auth.token &&
          request.auth.token.email == 'ahmedabdoshouq@gmail.com' &&
          'email_verified' in request.auth.token &&
          request.auth.token.email_verified == true
        )
      );
    }

    function isValidSpecialist(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.title is string && data.title.size() <= 150 &&
             data.isOnline is bool &&
             (!('isVerified' in data) || data.isVerified is bool) &&
             (!('isSuspended' in data) || data.isSuspended is bool) &&
             (!('qualificationTitle' in data) || (data.qualificationTitle is string && data.qualificationTitle.size() <= 200)) &&
             (!('applicationId' in data) || (data.applicationId is string && data.applicationId.size() <= 128)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000)) &&
             (!('rating' in data) || data.rating is number) &&
             (!('completedChats' in data) || data.completedChats is int) &&
             (!('experienceYears' in data) || data.experienceYears is int) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 20 && (data.tags.size() == 0 || data.tags[0] is string))) &&
             (!('avatarInitials' in data) || (data.avatarInitials is string && data.avatarInitials.size() <= 10)) &&
             (!('avatarBgHex' in data) || data.avatarBgHex is int) &&
             (!('supportsUrgentCare' in data) || data.supportsUrgentCare is bool) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidSpecialistApplication(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.professionalTitle is string && data.professionalTitle.size() >= 2 && data.professionalTitle.size() <= 150 &&
             data.qualificationTitle is string && data.qualificationTitle.size() >= 2 && data.qualificationTitle.size() <= 200 &&
             data.attachmentFileName is string && data.attachmentFileName.size() > 0 && data.attachmentFileName.size() <= 200 &&
             data.attachmentMimeType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'] &&
             data.attachmentBase64 is string && data.attachmentBase64.size() > 0 && data.attachmentBase64.size() <= 850000 &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED', 'SUSPENDED'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('applicantEmail' in data) || (data.applicantEmail is string && data.applicantEmail.size() <= 150)) &&
             (!('qualificationInstitution' in data) || (data.qualificationInstitution is string && data.qualificationInstitution.size() <= 200)) &&
             (!('attachmentSizeBytes' in data) || (data.attachmentSizeBytes is int && data.attachmentSizeBytes >= 0 && data.attachmentSizeBytes <= 2000000)) &&
             (!('specialtyTags' in data) || (data.specialtyTags is list && data.specialtyTags.size() <= 15 && (data.specialtyTags.size() == 0 || data.specialtyTags[0] is string))) &&
             (!('experienceYears' in data) || (data.experienceYears is int && data.experienceYears >= 0 && data.experienceYears <= 70)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000)) &&
             (!('supportsUrgentCare' in data) || data.supportsUrgentCare is bool) &&
             (!('reviewerId' in data) || data.reviewerId == null || (data.reviewerId is string && data.reviewerId.size() <= 128)) &&
             (!('reviewerEmail' in data) || data.reviewerEmail == null || (data.reviewerEmail is string && data.reviewerEmail.size() <= 150)) &&
             (!('reviewerNote' in data) || data.reviewerNote == null || (data.reviewerNote is string && data.reviewerNote.size() <= 500)) &&
             (!('rejectionReason' in data) || data.rejectionReason == null || (data.rejectionReason is string && data.rejectionReason.size() <= 500)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time)) &&
             (!('reviewedAt' in data) || data.reviewedAt == null || (data.reviewedAt is timestamp && data.reviewedAt <= request.time));
    }

    function isValidConversation(data) {
      return data.specialistId is string && data.specialistId.size() <= 128 &&
             data.seekerId is string && data.seekerId.size() <= 128 &&
             data.topic is string && data.topic.size() <= 200 &&
             data.status in ['ACTIVE', 'RESOLVED'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('acceptedBySpecialist' in data) || data.acceptedBySpecialist is bool) &&
             (!('specialistName' in data) || (data.specialistName is string && data.specialistName.size() <= 100)) &&
             (!('specialistTitle' in data) || (data.specialistTitle is string && data.specialistTitle.size() <= 150)) &&
             (!('seekerName' in data) || (data.seekerName is string && data.seekerName.size() <= 100)) &&
             (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 1000)) &&
             (!('lastMessageSenderId' in data) || (data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128)) &&
             (!('lastMessageFromSpecialist' in data) || data.lastMessageFromSpecialist is bool) &&
             (!('lastMessageTime' in data) || (data.lastMessageTime is timestamp && data.lastMessageTime <= request.time)) &&
             (!('isUrgent' in data) || data.isUrgent is bool) &&
             (!('unreadCount' in data) || data.unreadCount is int) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidMessage(data) {
      return data.conversationId is string && data.conversationId.size() <= 128 &&
             data.senderId is string && data.senderId == request.auth.uid &&
             data.receiverId is string && data.receiverId.size() <= 128 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 5000 &&
             data.isFromSpecialist is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 100));
    }

    function isValidBookingSlot(data) {
      return data.specialistId is string && data.specialistId.size() <= 128 &&
             data.specialistName is string && data.specialistName.size() <= 100 &&
             data.dateText is string && data.dateText.size() <= 100 &&
             data.timeText is string && data.timeText.size() <= 100 &&
             data.isBooked is bool &&
             (!('specialtyTitle' in data) || (data.specialtyTitle is string && data.specialtyTitle.size() <= 150)) &&
             (!('bookedById' in data) || data.bookedById == null || (data.bookedById is string && data.bookedById.size() <= 128)) &&
             (!('bookedByName' in data) || data.bookedByName == null || (data.bookedByName is string && data.bookedByName.size() <= 100)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // 0. Admins (Supervisors) Collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(adminId);
    }

    // 1. Specialist Applications Collection (Requires Supervisor review of attached qualification)
    match /specialist_applications/{applicantId} {
      allow get: if isSignedIn() && isValidId(applicantId) && (request.auth.uid == applicantId || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(applicantId) &&
                       request.auth.uid == applicantId &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       (!('reviewerId' in incoming()) || incoming().reviewerId == null) &&
                       (!('rejectionReason' in incoming()) || incoming().rejectionReason == null) &&
                       isValidSpecialistApplication(incoming());

      allow update: if isSignedIn() &&
                       isValidId(applicantId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidSpecialistApplication(incoming()) &&
                       (
                         // Supervisor reviews, approves, rejects, or suspends after checking qualification
                         isAdmin() ||
                         // Applicant edits or resubmits while PENDING or REJECTED (cannot self-approve)
                         (
                           request.auth.uid == applicantId &&
                           existing().userId == request.auth.uid &&
                           existing().status in ['PENDING', 'REJECTED'] &&
                           incoming().status == 'PENDING' &&
                           (!('reviewerId' in incoming()) || incoming().reviewerId == null) &&
                           (!('rejectionReason' in incoming()) || incoming().rejectionReason == null)
                         )
                       );

      allow delete: if isValidId(applicantId) && (
                       isAdmin() ||
                       (isSignedIn() && request.auth.uid == applicantId && existing().status in ['PENDING', 'REJECTED'])
                    );
    }

    // 2. Specialists Collection (Only Supervisors can publish/approve specialists)
    match /specialists/{specialistId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
                       isValidId(specialistId) &&
                       isValidSpecialist(incoming()) &&
                       isAdmin();
      allow update: if isSignedIn() &&
                       isValidId(specialistId) &&
                       incoming().userId == existing().userId &&
                       isValidSpecialist(incoming()) &&
                       (
                         isAdmin() ||
                         (
                           (existing().userId == request.auth.uid || specialistId == request.auth.uid) &&
                           (!existing().get('isSuspended', false) || !incoming().isOnline) &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['isOnline', 'title', 'bio', 'tags', 'experienceYears', 'supportsUrgentCare', 'updatedAt'])
                         )
                       );
      allow delete: if isValidId(specialistId) && isAdmin();
    }

    // 3. Conversations Collection
    match /conversations/{conversationId} {
      allow get: if isSignedIn() &&
                    isValidId(conversationId) &&
                    (resource.data.seekerId == request.auth.uid || resource.data.specialistId == request.auth.uid);
      allow list: if isSignedIn() &&
                     (resource.data.seekerId == request.auth.uid || resource.data.specialistId == request.auth.uid);
      allow create: if isSignedIn() &&
                       isValidId(conversationId) &&
                       (incoming().seekerId == request.auth.uid || incoming().specialistId == request.auth.uid) &&
                       isValidConversation(incoming());
      allow update: if isSignedIn() &&
                       isValidId(conversationId) &&
                       (existing().seekerId == request.auth.uid || existing().specialistId == request.auth.uid) &&
                       incoming().seekerId == existing().seekerId &&
                       incoming().specialistId == existing().specialistId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidConversation(incoming());
      allow delete: if isSignedIn() &&
                       (existing().seekerId == request.auth.uid || existing().specialistId == request.auth.uid);

      // 4. Subcollection: Messages
      match /messages/{messageId} {
        allow get, list: if isSignedIn() &&
                            (get(/databases/$(database)/documents/conversations/$(conversationId)).data.seekerId == request.auth.uid ||
                             get(/databases/$(database)/documents/conversations/$(conversationId)).data.specialistId == request.auth.uid);
        allow create: if isSignedIn() &&
                         isValidId(messageId) &&
                         incoming().conversationId == conversationId &&
                         incoming().senderId == request.auth.uid &&
                         (get(/databases/$(database)/documents/conversations/$(conversationId)).data.seekerId == request.auth.uid ||
                          get(/databases/$(database)/documents/conversations/$(conversationId)).data.specialistId == request.auth.uid) &&
                         isValidMessage(incoming());
        allow update, delete: if false; // Messages are immutable audit log
      }
    }

    // 5. Booking Slots Collection
    match /bookingSlots/{slotId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
                       isValidId(slotId) &&
                       incoming().specialistId == request.auth.uid &&
                       isValidBookingSlot(incoming());
      allow update: if isSignedIn() &&
                       isValidId(slotId) &&
                       incoming().specialistId == existing().specialistId &&
                       isValidBookingSlot(incoming()) &&
                       (
                         // Specialist can edit their own slot
                         existing().specialistId == request.auth.uid ||
                         // Seeker can book an unbooked slot
                         (!existing().isBooked && incoming().isBooked && incoming().bookedById == request.auth.uid) ||
                         // Seeker can cancel their own booking
                         (existing().isBooked && !incoming().isBooked && existing().bookedById == request.auth.uid && incoming().bookedById == null)
                       );
      allow delete: if isSignedIn() && (existing().specialistId == request.auth.uid || isAdmin());
    }

    // 6. Reports Collection (Users create; Supervisors review)
    match /reports/{reportId} {
      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().conversationId is string && incoming().conversationId.size() <= 128 &&
                       incoming().specialistId is string && incoming().specialistId.size() <= 128 &&
                       incoming().reason is string && incoming().reason.size() > 0 && incoming().reason.size() <= 300 &&
                       (!('details' in incoming()) || (incoming().details is string && incoming().details.size() <= 1000)) &&
                       (!('status' in incoming()) || incoming().status == 'OPEN') &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time;
      allow get, list: if isAdmin();
      allow update: if isAdmin() &&
                       isValidId(reportId) &&
                       incoming().userId == existing().userId &&
                       incoming().conversationId == existing().conversationId &&
                       incoming().specialistId == existing().specialistId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().status in ['OPEN', 'REVIEWED', 'ACTION_TAKEN'] &&
                       (!('reviewedNote' in incoming()) || incoming().reviewedNote == null || (incoming().reviewedNote is string && incoming().reviewedNote.size() <= 500)) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedNote']);
      allow delete: if false;
    }

    // 7. Blocks Collection
    match /blocks/{blockId} {
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(blockId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().specialistId is string &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time;
      allow update, delete: if false;
    }

    // 8. Session Moods Collection
    match /session_moods/{moodId} {
      allow create: if isSignedIn() &&
                       isValidId(moodId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().conversationId is string &&
                       incoming().mood is string &&
                       incoming().moodScore is int &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time;
      allow list, get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
